local tradeActive = false
local lastYourValue = -1
local lastTheirValue = -1

task.spawn(function()
    while task.wait(1) do
        local data = getTradeData()
        
        if not data then
            if tradeActive then
                tradeActive = false
                StatusDot.BackgroundColor3 = C.Red
                StatusText.Text = "System No Active"
                StatusText.TextColor3 = C.Red
                systemLog("Trade closed")
                lastYourValue = -1
                lastTheirValue = -1
            end
        else
            if not tradeActive then
                tradeActive = true
                StatusDot.BackgroundColor3 = C.Green
                StatusText.Text = "System Activated"
                StatusText.TextColor3 = C.Green
                systemLog("TRADE DETECTED!")
                systemLog("Trading with: " .. data.playerName)
            end
            
            if data.yourValue ~= lastYourValue or data.theirValue ~= lastTheirValue then
                lastYourValue = data.yourValue
                lastTheirValue = data.theirValue
                
                local yourTotal = data.yourValue + data.yourDiamonds
                local theirTotal = data.theirValue + data.theirDiamonds
                
                systemLog("=== UPDATE ===")
                
                if data.yourDiamonds > 0 then
                    valueLog("YOU: " .. data.yourValueText .. " + " .. formatValue(data.yourDiamonds) .. " diamonds")
                    valueLog("Total: " .. formatValue(yourTotal))
                else
                    valueLog("YOU: " .. data.yourValueText)
                end
                
                if data.theirDiamonds > 0 then
                    valueLog("THEM: " .. data.theirValueText .. " + " .. formatValue(data.theirDiamonds) .. " diamonds")
                    valueLog("Total: " .. formatValue(theirTotal))
                else
                    valueLog("THEM: " .. data.theirValueText)
                end
                
                local diff = theirTotal - yourTotal
                local percent = 0
                if yourTotal > 0 then percent = (diff / yourTotal) * 100
                elseif theirTotal > 0 then percent = 999 end
                
                if diff > 0 then
                    systemLog("Profit: +" .. formatValue(diff))
                elseif diff < 0 then
                    systemLog("Loss: " .. formatValue(diff))
                else
                    systemLog("Equal")
                end
                
                if yourTotal == 0 and theirTotal == 0 then
                    fairLog("Empty trade")
                elseif percent >= 30 then
                    winLog("HUGE WIN - ACCEPT FAST!")
                elseif percent >= 10 then
                    winLog("WIN - Good deal")
                elseif percent >= -10 then
                    fairLog("FAIR - Balanced")
                elseif percent >= -30 then
                    loseLog("LOSS - Decline")
                else
                    loseLog("HUGE LOSS - SCAM!")
                end
            end
        end
    end
end)

