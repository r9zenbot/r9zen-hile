local function parseValue(str)
    if not str or str == "" then return 0 end
    str = str:gsub(",", ""):gsub("%s+", ""):lower()
    local num, suffix = str:match("([%d%.]+)([kmbt]?)")
    if not num then return 0 end
    local value = tonumber(num) or 0
    if suffix == "k" then value = value * 1e3
    elseif suffix == "m" then value = value * 1e6
    elseif suffix == "b" then value = value * 1e9
    elseif suffix == "t" then value = value * 1e12 end
    return value
end

local function formatValue(v)
    if v >= 1e12 then return string.format("%.2fT", v/1e12)
    elseif v >= 1e9 then return string.format("%.2fB", v/1e9)
    elseif v >= 1e6 then return string.format("%.2fM", v/1e6)
    elseif v >= 1e3 then return string.format("%.1fK", v/1e3)
    else return tostring(math.floor(v)) end
end

local function getTradeData()
    local tw = playerGui:FindFirstChild("TradeWindow")
    if not tw or not tw.Enabled then return nil end
    local frame = tw:FindFirstChild("Frame")
    if not frame then return nil end
    
    local clientRAP = frame:FindFirstChild("ClientRAPHolder")
    local yourValue, yourValueText = 0, "0"
    if clientRAP then
        local amount = clientRAP:FindFirstChild("Amount")
        if amount and amount:IsA("TextLabel") then
            yourValueText = amount.Text
            yourValue = parseValue(amount.Text)
        end
    end
    
    local playerRAP = frame:FindFirstChild("PlayerRAPHolder")
    local theirValue, theirValueText = 0, "0"
    if playerRAP then
        local amount = playerRAP:FindFirstChild("Amount")
        if amount and amount:IsA("TextLabel") then
            theirValueText = amount.Text
            theirValue = parseValue(amount.Text)
        end
    end
    
    local playerTitle = frame:FindFirstChild("PlayerTitle")
    local playerName = playerTitle and playerTitle.Text or "Unknown"
    
    local clientDiamonds = frame:FindFirstChild("ClientDiamonds")
    local yourDiamonds = 0
    if clientDiamonds then
        local d = clientDiamonds:FindFirstChild("Diamonds")
        if d then local input = d:FindFirstChild("Input")
            if input and input:IsA("TextBox") then yourDiamonds = parseValue(input.Text) end end
    end
    
    local playerDiamonds = frame:FindFirstChild("PlayerDiamonds")
    local theirDiamonds = 0
    if playerDiamonds then
        local tl = playerDiamonds:FindFirstChild("TextLabel")
        if tl and tl:IsA("TextLabel") then theirDiamonds = parseValue(tl.Text) end
    end
    
    return {
        yourValue = yourValue, yourValueText = yourValueText,
        theirValue = theirValue, theirValueText = theirValueText,
        playerName = playerName,
        yourDiamonds = yourDiamonds, theirDiamonds = theirDiamonds,
    }
end

