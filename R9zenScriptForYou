    if S.fly then if i.KeyCode==Enum.KeyCode.W then fk.W=true end if i.KeyCode==Enum.KeyCode.A then fk.A=true end if i.KeyCode==Enum.KeyCode.S then fk.S=true end if i.KeyCode==Enum.KeyCode.D then fk.D=true end if i.KeyCode==Enum.KeyCode.LeftShift then fk.Shift=true end end
    if i.KeyCode==Enum.KeyCode.E then HE=true end
    if i.KeyCode==Enum.KeyCode.N then S.noclip=not S.noclip if AB["nc"] then AB["nc"].Set(S.noclip) end if S.noclip then NOn() else NOff() end end
    if i.KeyCode==Enum.KeyCode.C then HC3=true if S.slide then SlOn() end end
    if i.KeyCode==Enum.KeyCode.G then S.galaxy=not S.galaxy if AB["gl"] then AB["gl"].Set(S.galaxy) end if S.galaxy then GOn() else GOff() end end
    if i.KeyCode==Enum.KeyCode.X then S.spin=not S.spin SA=0 if AB["sp"] then AB["sp"].Set(S.spin) end end
    if i.KeyCode==Enum.KeyCode.V then S.fly=not S.fly if AB["fl"] then AB["fl"].Set(S.fly) end if S.fly then SFly() else EFly() end end
    if i.KeyCode==Enum.KeyCode.Q then S.tp=not S.tp if AB["tp"] then AB["tp"].Set(S.tp) end if not S.tp then Cam.CameraType=Enum.CameraType.Custom if LP.Character and LP.Character:FindFirstChild("Humanoid") then Cam.CameraSubject=LP.Character.Humanoid end LP.CameraMaxZoomDistance=128 LP.CameraMinZoomDistance=0.5 end end
    if i.KeyCode==Enum.KeyCode.Delete then S.stream=not S.stream if AB["st"] then AB["st"].Set(S.stream) end end
    if i.KeyCode==Enum.KeyCode.RightShift then if S.stream then return end MenuV=not MenuV if MenuV then M.Visible=true TS:Create(M,TweenInfo.new(0.2),{Position=UDim2.new(0.5,-170,0.5,-250)}):Play() else TS:Create(M,TweenInfo.new(0.15),{Position=UDim2.new(0.5,-170,1.5,0)}):Play() task.wait(0.15) M.Visible=false end end
end)

UIS.InputEnded:Connect(function(i) if i.KeyCode==Enum.KeyCode.E then HE=false pcall(function() local h=LP.Character and LP.Character:FindFirstChildOfClass("Humanoid") if h then h.AutoRotate=true end end) end if i.KeyCode==Enum.KeyCode.W then fk.W=false end if i.KeyCode==Enum.KeyCode.A then fk.A=false end if i.KeyCode==Enum.KeyCode.S then fk.S=false end if i.KeyCode==Enum.KeyCode.D then fk.D=false end if i.KeyCode==Enum.KeyCode.LeftShift then fk.Shift=false end if i.KeyCode==Enum.KeyCode.C then HC3=false SlOff() end end)

UIS.InputChanged:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseWheel and S.tp then S.cd=math.clamp(S.cd-i.Position.Z*2,5,30) end end)

RunService.RenderStepped:Connect(function()
    Cam=workspace.CurrentCamera local mc=LP.Character
    if not S.stream then if FC then FC.Position=Vector2.new(Cam.ViewportSize.X/2,Cam.ViewportSize.Y/2) FC.Radius=S.fov FC.Visible=S.aim end else if FC then FC.Visible=false end end
    if S.gfov<=120 then Cam.FieldOfView=S.gfov else pcall(function() Cam.FieldOfView=120 Cam.DiagonalFieldOfView=S.gfov end) end

    if S.aim and HE and mc then local t=GetT() if t and t.Character and t.Character:FindFirstChild(S.part) then local tp=t.Character[S.part].Position local mr=mc:FindFirstChild("HumanoidRootPart") Cam.CFrame=CFrame.new(Cam.CFrame.Position,tp) if mr and not S.spin then pcall(function() local h=mc:FindFirstChildOfClass("Humanoid") if h then h.AutoRotate=false end local ld=(tp-mr.Position) local fd=Vector3.new(ld.X,0,ld.Z) if fd.Magnitude>0.1 then mr.CFrame=CFrame.new(mr.Position,mr.Position+fd.Unit) end end) end end
    else if mc then local h=mc:FindFirstChildOfClass("Humanoid") if h and not h.AutoRotate then pcall(function() h.AutoRotate=true end) end end end

    if S.spin and mc and mc:FindFirstChild("HumanoidRootPart") then if not(S.aim and HE) then SA=(SA+S.spspd)%360 mc.HumanoidRootPart.CFrame=CFrame.new(mc.HumanoidRootPart.Position)*CFrame.Angles(0,math.rad(SA),0) end end

    if S.tp and mc and mc:FindFirstChild("HumanoidRootPart") then LP.CameraMaxZoomDistance=S.cd LP.CameraMinZoomDistance=S.cd Cam.CameraType=Enum.CameraType.Scriptable local hr=mc.HumanoidRootPart local lk=Cam.CFrame.LookVector local tp2=hr.Position+Vector3.new(0,S.ch,0)-lk*S.cd Cam.CFrame=Cam.CFrame:Lerp(CFrame.new(tp2,hr.Position+Vector3.new(0,S.ch,0)),0.15) end

    local s={}
    if S.aim and HE then local t=GetT() table.insert(s,t and(">"..t.Name) or "Aim") elseif S.aim then table.insert(s,"AimE") end
    if S.dodge then table.insert(s,"Dg") end if S.noclip then table.insert(s,"NC") end if S.spin then table.insert(s,"Sp") end if S.fly then table.insert(s,"Fly") end if S.tp then table.insert(s,"TP") end if Sliding then table.insert(s,"Sl") end
    Stat.Text=#s>0 and table.concat(s,"|") or "Ready"

    for p,d in pairs(ET) do
        if not S.esp or S.stream or not IsE(p) then d.Box.Visible=false d.Line.Visible=false d.Name.Visible=false d.Health.Visible=false continue end
        local c=p.Character if not c then d.Box.Visible=false d.Line.Visible=false d.Name.Visible=false d.Health.Visible=false continue end
        local hr=c:FindFirstChild("HumanoidRootPart") local hd=c:FindFirstChild("Head") local hm=c:FindFirstChild("Humanoid")
        if not hr or not hd or not hm or hm.Health<=0 then d.Box.Visible=false d.Line.Visible=false d.Name.Visible=false d.Health.Visible=false continue end
        local rp,rv=Cam:WorldToViewportPoint(hr.Position) local hp2=Cam:WorldToViewportPoint(hd.Position+Vector3.new(0,0.5,0))
        if rv and rp.Z>0 then local h2=math.abs(hp2.Y-rp.Y)*2.3 local w=h2/2 local it=HE and GetT()==p local ec=it and Color3.fromRGB(255,50,50) or Color3.new(1,1,1)
            if S.box then d.Box.Size=Vector2.new(w,h2) d.Box.Position=Vector2.new(rp.X-w/2,rp.Y-h2/2) d.Box.Color=ec d.Box.Visible=true else d.Box.Visible=false end
            if S.line then d.Line.From=Vector2.new(Cam.ViewportSize.X/2,Cam.ViewportSize.Y) d.Line.To=Vector2.new(rp.X,rp.Y) d.Line.Color=ec d.Line.Visible=true else d.Line.Visible=false end
            if S.nme then local mr2=mc and mc:FindFirstChild("HumanoidRootPart") local ds=mr2 and math.floor((mr2.Position-hr.Position).Magnitude) or 0 d.Name.Text=p.Name.." "..ds.."m" d.Name.Position=Vector2.new(rp.X,rp.Y-h2/2-16) d.Name.Color=ec d.Name.Visible=true else d.Name.Visible=false end
            if S.hp then local hp3=hm.Health/hm.MaxHealth d.Health.From=Vector2.new(rp.X-w/2-4,rp.Y+h2/2) d.Health.To=Vector2.new(rp.X-w/2-4,rp.Y+h2/2-h2*hp3) d.Health.Color=Color3.fromRGB(255*(1-hp3),255*hp3,0) d.Health.Visible=true else d.Health.Visible=false end
        else d.Box.Visible=false d.Line.Visible=false d.Name.Visible=false d.Health.Visible=false end
    end
end)

