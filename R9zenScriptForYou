local function GetT()
    local cl,sh=nil,S.fov local ct=Vector2.new(Cam.ViewportSize.X/2,Cam.ViewportSize.Y/2) local mc=LP.Character
    if not mc or not mc:FindFirstChild("HumanoidRootPart") then return nil end
    for _,p in ipairs(Players:GetPlayers()) do if p==LP then continue end if LP.Team and p.Team and LP.Team==p.Team then continue end
        local c=p.Character if not c then continue end local pt=c:FindFirstChild(S.part) local h=c:FindFirstChildOfClass("Humanoid")
        if not pt or not h or h.Health<=0 then continue end local ok,st=pcall(function() return h:GetState() end)
        if ok and st==Enum.HumanoidStateType.Dead then continue end
        local d3=(mc.HumanoidRootPart.Position-pt.Position).Magnitude if d3>S.range then continue end
        local ps,on=Cam:WorldToViewportPoint(pt.Position) if on then local d=(Vector2.new(ps.X,ps.Y)-ct).Magnitude if d<sh then sh=d cl=p end end
    end return cl end

