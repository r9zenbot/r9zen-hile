-- ============================================================
-- ULTRA VISION FILTER (GELİŞTİRİLMİŞ TESPİT)
-- ============================================================
local function isBubble(v)
    if not v:IsA("BasePart") or v.Transparency >= 0.9 then return false end
    
    -- Oyuncu Karakteri Kontrolü
    local model = v:FindFirstAncestorWhichIsA("Model")
    if model and Players:GetPlayerFromCharacter(model) then return false end
    
    local n = v.Name:lower()
    local s = v.Size
    
    -- Kapı / Duvar engelleme (Boyut bazlı)
    if s.X > 7 or s.Y > 7 or s.Z > 7 then return false end
    
    -- Anahtar kelimeler
    local validName = n:find("bubble") or n:find("ticket") or n:find("token") or n:find("orb") or n:find("event") or n:find("item")
    
    -- Evade Baloncuğu Kontrolü
    if validName and not v:IsDescendantOf(LP.Character) then
        -- Eğer parça çok inceyse (duvar/kapı olma ihtimali) engelle
        if s.X < 0.2 or s.Z < 0.2 then return false end
        return true
    end
    
    return false
end

local function getTarget()
    local target, dist = nil, math.huge
    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    -- Workspace'teki tüm parçaları hızlıca tara
    local descendants = WS:GetDescendants()
    for i = 1, #descendants do
        local v = descendants[i]
        if isBubble(v) then
            local d = (v.Position - hrp.Position).Magnitude
            if d < dist then
                dist = d
                target = v
            end
        end
    end
    return target
end

-- ============================================================
-- MOVEMENT (INSTANT TP & SMOOTH GLIDE)
-- ============================================================
local function tpSky()
    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.CFrame = CFrame.new(hrp.Position.X, State.safeY, hrp.Position.Z)
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    end
end

local function glide(pos)
    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local duration = (pos - hrp.Position).Magnitude / State.speed
    local tween = TS:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = CFrame.new(pos)})
    
    local con = RS.Heartbeat:Connect(function() 
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0) 
        hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    end)
    
    tween:Play()
    tween.Completed:Wait()
    con:Disconnect()
end

local function collect(v)
    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not hrp or not v then return end
    
    -- Proximity Prompt tetikle
    local prompt = v:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt and fireproximityprompt then fireproximityprompt(prompt) end
    
    -- Çoklu Dokunma (Garanti toplama)
    if firetouchinterest then
        for i = 1, 3 do
            firetouchinterest(hrp, v, 0)
            task.wait(0.02)
            firetouchinterest(hrp, v, 1)
        end
    end
end

local function runFarm()
    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    State.safeY = hrp and (hrp.Position.Y + 160) or 170
    
    tpSky()
    
    while State.farm do
        local target = getTarget()
        if target and target.Parent then
            State.status = "Gliding to target"
            glide(target.Position + Vector3.new(0, 1.2, 0))
            
            State.status = "Collecting bubble"
            collect(target)
            
            task.wait(2.5) -- 2.5 Saniye Bekleme
            
            State.collected = State.collected + 1
            State.status = "Teleporting to sky"
            tpSky()
            task.wait(0.5)
        else
            State.status = "Searching for bubbles"
            task.wait(0.5) -- Daha hızlı tarama için 0.5s bekleme
        end
    end
end

