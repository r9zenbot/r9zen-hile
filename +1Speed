local function createDropdown(parent, name, options, default, callback)
    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, 0, 0, 55)
    holder.BackgroundTransparency = 1
    holder.Parent = parent
    holder.ClipsDescendants = false
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 16)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = C.Text
    label.TextSize = 12
    label.Font = Enum.Font.GothamSemibold
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = holder
    
    local dropBtn = Instance.new("TextButton")
    dropBtn.Size = UDim2.new(1, 0, 0, 32)
    dropBtn.Position = UDim2.new(0, 0, 0, 20)
    dropBtn.BackgroundColor3 = C.Dropdown
    dropBtn.Text = ""
    dropBtn.BorderSizePixel = 0
    dropBtn.AutoButtonColor = false
    dropBtn.Parent = holder
    Instance.new("UICorner", dropBtn).CornerRadius = UDim.new(0, 5)
    local dbs = Instance.new("UIStroke", dropBtn)
    dbs.Color = C.Border
    
    local selectedText = Instance.new("TextLabel")
    selectedText.Size = UDim2.new(1, -40, 1, 0)
    selectedText.Position = UDim2.new(0, 12, 0, 0)
    selectedText.BackgroundTransparency = 1
    selectedText.Text = default or "Select..."
    selectedText.TextColor3 = default and C.Text or C.TextDim
    selectedText.TextSize = 12
    selectedText.Font = Enum.Font.Gotham
    selectedText.TextXAlignment = Enum.TextXAlignment.Left
    selectedText.Parent = dropBtn
    
    local arrow = Instance.new("TextLabel")
    arrow.Size = UDim2.new(0, 20, 1, 0)
    arrow.Position = UDim2.new(1, -25, 0, 0)
    arrow.BackgroundTransparency = 1
    arrow.Text = "▼"
    arrow.TextColor3 = C.Accent
    arrow.TextSize = 10
    arrow.Font = Enum.Font.GothamBold
    arrow.Parent = dropBtn
    
    -- Dropdown list (ayrı frame, üstte açılır)
    local listHolder = Instance.new("Frame")
    listHolder.Size = UDim2.new(1, 0, 0, 0)
    listHolder.Position = UDim2.new(0, 0, 0, 54)
    listHolder.BackgroundColor3 = C.Dropdown
    listHolder.BorderSizePixel = 0
    listHolder.Visible = false
    listHolder.ZIndex = 10
    listHolder.ClipsDescendants = true
    listHolder.Parent = holder
    Instance.new("UICorner", listHolder).CornerRadius = UDim.new(0, 5)
    local lhs = Instance.new("UIStroke", listHolder)
    lhs.Color = C.Accent
    lhs.Transparency = 0.5
    
    local scroll = Instance.new("ScrollingFrame")
    scroll.Size = UDim2.new(1, 0, 1, 0)
    scroll.BackgroundTransparency = 1
    scroll.ScrollBarThickness = 3
    scroll.ScrollBarImageColor3 = C.Accent
    scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    scroll.BorderSizePixel = 0
    scroll.ZIndex = 10
    scroll.Parent = listHolder
    
    local listLayout = Instance.new("UIListLayout")
    listLayout.Padding = UDim.new(0, 2)
    listLayout.Parent = scroll
    
    local listPad = Instance.new("UIPadding")
    listPad.PaddingTop = UDim.new(0, 3)
    listPad.PaddingBottom = UDim.new(0, 3)
    listPad.PaddingLeft = UDim.new(0, 3)
    listPad.PaddingRight = UDim.new(0, 3)
    listPad.Parent = scroll
    
    local isOpen = false
    local currentValue = default
    
    -- Option'ları oluştur
    for _, opt in ipairs(options) do
        local optBtn = Instance.new("TextButton")
        optBtn.Size = UDim2.new(1, 0, 0, 26)
        optBtn.BackgroundColor3 = C.Section
        optBtn.Text = ""
        optBtn.BorderSizePixel = 0
        optBtn.AutoButtonColor = false
        optBtn.ZIndex = 11
        optBtn.Parent = scroll
        Instance.new("UICorner", optBtn).CornerRadius = UDim.new(0, 4)
        
        local optText = Instance.new("TextLabel")
        optText.Size = UDim2.new(1, -12, 1, 0)
        optText.Position = UDim2.new(0, 10, 0, 0)
        optText.BackgroundTransparency = 1
        optText.Text = opt
        optText.TextColor3 = C.Text
        optText.TextSize = 12
        optText.Font = Enum.Font.Gotham
        optText.TextXAlignment = Enum.TextXAlignment.Left
        optText.ZIndex = 11
        optText.Parent = optBtn
        
        optBtn.MouseEnter:Connect(function()
            TweenService:Create(optBtn, TweenInfo.new(0.1), {BackgroundColor3 = C.AccentDark}):Play()
        end)
        optBtn.MouseLeave:Connect(function()
            TweenService:Create(optBtn, TweenInfo.new(0.1), {BackgroundColor3 = C.Section}):Play()
        end)
        
        optBtn.MouseButton1Click:Connect(function()
            currentValue = opt
            selectedText.Text = opt
            selectedText.TextColor3 = C.Text
            isOpen = false
            listHolder.Visible = false
            arrow.Text = "▼"
            holder.Size = UDim2.new(1, 0, 0, 55)
            openDropdown = nil
            if callback then callback(opt) end
        end)
    end
    
    dropBtn.MouseButton1Click:Connect(function()
        -- Diğer dropdown açıksa kapat
        if openDropdown and openDropdown ~= holder then
            openDropdown.Visible = false
            openDropdown.Parent.Size = UDim2.new(1, 0, 0, 55)
            local otherArrow = openDropdown.Parent:FindFirstChild("TextButton") 
            if otherArrow then
                for _, c in pairs(openDropdown.Parent:GetDescendants()) do
                    if c:IsA("TextLabel") and c.Text == "▲" then c.Text = "▼" end
                end
            end
        end
        
        isOpen = not isOpen
        if isOpen then
            listHolder.Visible = true
            local listSize = math.min(#options * 28 + 6, 150)
            listHolder.Size = UDim2.new(1, 0, 0, listSize)
            holder.Size = UDim2.new(1, 0, 0, 55 + listSize + 5)
            arrow.Text = "▲"
            openDropdown = listHolder
        else
            listHolder.Visible = false
            holder.Size = UDim2.new(1, 0, 0, 55)
            arrow.Text = "▼"
            openDropdown = nil
        end
    end)
    
    return function() return currentValue end
end

local function createToggle(p, name, cb)
    local t = Instance.new("TextButton")
    t.Size = UDim2.new(1, 0, 0, 24)
    t.BackgroundTransparency = 1
    t.Text = ""
    t.AutoButtonColor = false
    t.Parent = p
    
    local box = Instance.new("Frame")
    box.Size = UDim2.new(0, 16, 0, 16)
    box.Position = UDim2.new(0, 0, 0.5, -8)
    box.BackgroundColor3 = C.Toggle
    box.BorderSizePixel = 0
    box.Parent = t
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 4)
    local bs = Instance.new("UIStroke", box)
    bs.Color = C.Border
    
    local ck = Instance.new("Frame")
    ck.Size = UDim2.new(0, 10, 0, 10)
    ck.Position = UDim2.new(0.5, -5, 0.5, -5)
    ck.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    ck.BackgroundTransparency = 1
    ck.BorderSizePixel = 0
    ck.Parent = box
    Instance.new("UICorner", ck).CornerRadius = UDim.new(0, 2)
    
    local lb = Instance.new("TextLabel")
    lb.Size = UDim2.new(1, -26, 1, 0)
    lb.Position = UDim2.new(0, 26, 0, 0)
    lb.BackgroundTransparency = 1
    lb.Text = name
    lb.TextColor3 = C.Text
    lb.TextSize = 12
    lb.Font = Enum.Font.Gotham
    lb.TextXAlignment = Enum.TextXAlignment.Left
    lb.Parent = t
    
    local s = false
    t.MouseButton1Click:Connect(function()
        s = not s
        TweenService:Create(ck, TweenInfo.new(0.15), {BackgroundTransparency = s and 0 or 1}):Play()
        TweenService:Create(box, TweenInfo.new(0.15), {BackgroundColor3 = s and C.Accent or C.Toggle}):Play()
        TweenService:Create(bs, TweenInfo.new(0.15), {Color = s and C.Accent or C.Border}):Play()
        cb(s)
    end)
    return function() return s end
end

