createButton(controlSec, "▶  START AUTO WIN", C.Green, function()
    if autoWinActive then return end
    
    local winName = getSelectedWin()
    if not winName then
        statusLabel.Text = "Status: ❌ Select a win first!"
        statusLabel.TextColor3 = C.Red
        return
    end
    
    local location = getLocationByName(winName)
    if not location then
        statusLabel.Text = "Status: ❌ Invalid location!"
        statusLabel.TextColor3 = C.Red
        return
    end
    
    autoWinActive = true
    tpCount = 0
    statusLabel.Text = "Status: ✅ Running - " .. winName
    statusLabel.TextColor3 = C.Green
    
    task.spawn(function()
        while autoWinActive do
            local char = player.Character
            if not char then
                player.CharacterAdded:Wait()
                task.wait(1)
            end
            
            char = player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            
            if hrp then
                -- TP to location
                hrp.CFrame = location.cframe
                tpCount = tpCount + 1
                countLabel.Text = "TP Count: " .. tpCount
                
                task.wait(0.15)
                
                if bypassEnabled and hrp then
                    -- Find all nearby win pads
                    local pads = findWinPadNear(location.cframe, 20)
                    
                    -- Fire touch on ALL nearby pads
                    for _, padData in pairs(pads) do
                        fireTouchAll(hrp, padData.part)
                    end
                    
                    -- Also fire touch on ALL character parts to be safe
                    for _, charPart in pairs(char:GetChildren()) do
                        if charPart:IsA("BasePart") then
                            for _, padData in pairs(pads) do
                                pcall(function()
                                    if firetouchinterest then
                                        firetouchinterest(charPart, padData.part, 0)
                                        firetouchinterest(charPart, padData.part, 1)
                                    end
                                end)
                            end
                        end
                    end
                end
                
                -- Wait for respawn OR delay
                local respawned = false
                local conn
                conn = player.CharacterAdded:Connect(function()
                    respawned = true
                end)
                
                local waited = 0
                while not respawned and waited < tpDelay and autoWinActive do
                    task.wait(0.1)
                    waited = waited + 0.1
                end
                
                if conn then conn:Disconnect() end
                
                if respawned then
                    task.wait(0.3) -- Wait for character to fully load
                end
            else
                task.wait(0.5)
            end
        end
    end)
end)

