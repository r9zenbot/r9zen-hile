local function fireTouchAll(hrp, part)
    -- Method 1: firetouchinterest (best method)
    if firetouchinterest then
        pcall(function()
            firetouchinterest(hrp, part, 0)
            firetouchinterest(hrp, part, 1)
        end)
    end
    
    -- Method 2: Trigger Touched event manually via TouchedConnection
    pcall(function()
        for _, connection in pairs(getconnections and getconnections(part.Touched) or {}) do
            pcall(function() connection:Fire(hrp) end)
        end
    end)
end

local function findWinPadNear(cframe, radius)
    local pads = {}
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") then
            local dist = (v.Position - cframe.Position).Magnitude
            if dist < radius then
                local n = v.Name:lower()
                if n:find("win") or n:find("pad") or n:find("finish") 
                    or n:find("end") or n:find("goal") or n:find("touch")
                    or n:find("teleport") or n:find("part") then
                    table.insert(pads, {part = v, dist = dist})
                end
            end
        end
    end
    -- En yakını başa koy
    table.sort(pads, function(a, b) return a.dist < b.dist end)
    return pads
end

