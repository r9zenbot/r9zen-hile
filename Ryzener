RunService.RenderStepped:Connect(function()
    Camera = workspace.CurrentCamera
    local myChar = LocalPlayer.Character

    if not StreamerMode then
        if FOVCircle then
            FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            FOVCircle.Radius = AimFOV
            FOVCircle.Visible = AimbotEnabled
        end
    else
        if FOVCircle then FOVCircle.Visible = false end
    end

    if GameFOV <= 120 then
        Camera.FieldOfView = GameFOV
    else
        pcall(function() Camera.FieldOfView = 120 Camera.DiagonalFieldOfView = GameFOV end)
    end

    -- AIMBOT (FIXED: Third Person + First Person)
    if AimbotEnabled and HoldingE then
        local target = GetClosestEnemy()
        if target and target.Character and target.Character:FindFirstChild(AimPart) then
            local targetPos = target.Character[AimPart].Position
            
            if myChar then
                local myHRP = myChar:FindFirstChild("HumanoidRootPart")
                
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPos)
                
                if myHRP then
                    pcall(function()
                        local lookDir = (targetPos - myHRP.Position)
                        local flatDir = Vector3.new(lookDir.X, 0, lookDir.Z)
                        if flatDir.Magnitude > 0.1 then
                            flatDir = flatDir.Unit
                            myHRP.CFrame = CFrame.new(myHRP.Position, myHRP.Position + flatDir)
                        end
                    end)
                    
                    local hum = myChar:FindFirstChildOfClass("Humanoid")
                    if hum then
                        pcall(function()
                            hum.AutoRotate = false
                        end)
                    end
                end
            end
        end
    end

    if SpinBotEnabled and myChar and myChar:FindFirstChild("HumanoidRootPart") then SpinAngle = (SpinAngle + SpinSpeed) % 360 myChar.HumanoidRootPart.CFrame = CFrame.new(myChar.HumanoidRootPart.Position) * CFrame.Angles(0, math.rad(SpinAngle), 0) end

    if ThirdPersonEnabled and myChar and myChar:FindFirstChild("HumanoidRootPart") then LocalPlayer.CameraMaxZoomDistance = CamDistance LocalPlayer.CameraMinZoomDistance = CamDistance Camera.CameraType = Enum.CameraType.Scriptable local hrp = myChar.HumanoidRootPart local lookDir = Camera.CFrame.LookVector local targetPos = hrp.Position + Vector3.new(0, CamHeight, 0) - lookDir * CamDistance Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(targetPos, hrp.Position + Vector3.new(0, CamHeight, 0)), 0.15) end

    local s = {}
    table.insert(s, "AC")
    table.insert(s, "Chat3m")
    if AimbotEnabled and HoldingE then 
        local t = GetClosestEnemy()
        table.insert(s, t and ("Aim>"..t.Name) or "Aim")
    elseif AimbotEnabled then
        table.insert(s, "AimE")
    end
    if HitboxEnabled then table.insert(s, "Hitbox"..HitboxSize) end
    if AutoDodgeEnabled then table.insert(s, "Dodge") end
    if NoclipEnabled then table.insert(s, "Noclip") end
    if StreamerMode then table.insert(s, "Stream") end
    if FPSBoosterEnabled then table.insert(s, "FPS") end
    if GalaxyMode then table.insert(s, "Galaxy") end
    if EnemyResizeEnabled then table.insert(s, "Resize" .. EnemyResizeAmount) end
    if SpinBotEnabled then table.insert(s, "Spin") end
    if FlyEnabled then table.insert(s, "Fly") end
    if ThirdPersonEnabled then table.insert(s, "TP") end
    if IsSliding then table.insert(s, "Slide") end
    if GameFOV ~= 70 then table.insert(s, "FOV" .. GameFOV) end
    Status.Text = table.concat(s, " | ")

    for plr, data in pairs(ESPTable) do
        if not ESPEnabled or StreamerMode or not IsEnemy(plr) then data.Box.Visible = false data.Line.Visible = false data.Name.Visible = false data.Health.Visible = false continue end
        local char = plr.Character if not char then data.Box.Visible = false data.Line.Visible = false data.Name.Visible = false data.Health.Visible = false continue end
        local hrp = char:FindFirstChild("HumanoidRootPart") local head = char:FindFirstChild("Head") local hum = char:FindFirstChild("Humanoid")
        if not hrp or not head or not hum or hum.Health <= 0 then data.Box.Visible = false data.Line.Visible = false data.Name.Visible = false data.Health.Visible = false continue end
        local rootScreen, rootVis = Camera:WorldToViewportPoint(hrp.Position) local headScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
        if rootVis and rootScreen.Z > 0 then
            local height = math.abs(headScreen.Y - rootScreen.Y) * 2.3 local width = height / 2
            local isTarget = HoldingE and GetClosestEnemy() == plr
            local espColor = isTarget and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(240, 240, 240)
            if ESPBox then data.Box.Size = Vector2.new(width, height) data.Box.Position = Vector2.new(rootScreen.X - width/2, rootScreen.Y - height/2) data.Box.Color = espColor data.Box.Visible = true else data.Box.Visible = false end
            if ESPLines then data.Line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y) data.Line.To = Vector2.new(rootScreen.X, rootScreen.Y) data.Line.Color = espColor data.Line.Visible = true else data.Line.Visible = false end
            if ESPNames then local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart") local dist = myHRP and math.floor((myHRP.Position - hrp.Position).Magnitude) or 0 data.Name.Text = plr.Name .. " " .. dist .. "m" data.Name.Position = Vector2.new(rootScreen.X, rootScreen.Y - height/2 - 18) data.Name.Color = espColor data.Name.Visible = true else data.Name.Visible = false end
            if ESPHealth then local hp = hum.Health / hum.MaxHealth data.Health.From = Vector2.new(rootScreen.X - width/2 - 5, rootScreen.Y + height/2) data.Health.To = Vector2.new(rootScreen.X - width/2 - 5, rootScreen.Y + height/2 - height * hp) data.Health.Color = Color3.fromRGB(255 * (1 - hp), 255 * hp, 0) data.Health.Visible = true else data.Health.Visible = false end
        else data.Box.Visible = false data.Line.Visible = false data.Name.Visible = false data.Health.Visible = false end
    end
end)

