local function Tog(text, default, callback, id, locked)
    local H = Instance.new("Frame") H.Size = UDim2.new(1, 0, 0, 36) H.BackgroundColor3 = BG_DARK H.BorderSizePixel = 0 H.ZIndex = 11 H.Parent = SC
    Instance.new("UICorner", H).CornerRadius = UDim.new(0, 4)
    local st = Instance.new("UIStroke", H) st.Color = BG_GRAY st.Thickness = 1
    local L = Instance.new("TextLabel") L.Size = UDim2.new(0.65, 0, 1, 0) L.Position = UDim2.new(0, 10, 0, 0) L.BackgroundTransparency = 1 L.Text = text L.TextColor3 = WHITE L.Font = Enum.Font.GothamSemibold L.TextSize = 12 L.TextXAlignment = Enum.TextXAlignment.Left L.ZIndex = 12 L.Parent = H
    local B = Instance.new("TextButton") B.Size = UDim2.new(0, 60, 0, 24) B.Position = UDim2.new(1, -68, 0.5, -12) B.BackgroundColor3 = default and WHITE or BG_GRAY B.Text = default and "ON" or "OFF" B.TextColor3 = default and BG_BLACK or LIGHT B.Font = Enum.Font.GothamBold B.TextSize = 11 B.BorderSizePixel = 0 B.ZIndex = 12 B.Parent = H
    Instance.new("UICorner", B).CornerRadius = UDim.new(0, 4)
    
    if locked then B.BackgroundColor3 = WHITE B.TextColor3 = BG_BLACK B.Text = "LOCKED" end
    
    H.MouseEnter:Connect(function() TweenService:Create(st, TweenInfo.new(0.15), {Color = WHITE}):Play() end)
    H.MouseLeave:Connect(function() TweenService:Create(st, TweenInfo.new(0.15), {Color = BG_GRAY}):Play() end)
    
    local state = default
    B.MouseButton1Click:Connect(function()
        if locked then return end
        state = not state
        B.Text = state and "ON" or "OFF"
        TweenService:Create(B, TweenInfo.new(0.15), {BackgroundColor3 = state and WHITE or BG_GRAY}):Play()
        B.TextColor3 = state and BG_BLACK or LIGHT
        callback(state)
    end)
    
    if id then AllToggleButtons[id] = {SetState = function(val) state = val B.Text = val and "ON" or "OFF" B.BackgroundColor3 = val and WHITE or BG_GRAY B.TextColor3 = val and BG_BLACK or LIGHT end} end
    return B
end

