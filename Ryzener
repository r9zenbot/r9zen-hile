-- =============== ENEMY RESIZE ===============
local function ResizeEnemies()
    if not EnemyResizeEnabled then return end
    local scale = EnemyResizeAmount / 100
    for _, plr in pairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        if plr.Character then
            for _, part in pairs(plr.Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    pcall(function()
                        if not EnemyOrigSizes[part] then EnemyOrigSizes[part] = part.Size end
                        local orig = EnemyOrigSizes[part]
                        part.Size = Vector3.new(orig.X * scale, orig.Y * scale, orig.Z * scale)
                    end)
                end
            end
        end
    end
end

local function RestoreEnemies()
    for part, orig in pairs(EnemyOrigSizes) do
        pcall(function() if part and part.Parent then part.Size = orig end end)
    end
    EnemyOrigSizes = {}
end

local function SetEnemyResize(enabled)
    EnemyResizeEnabled = enabled
    if enabled then ResizeEnemies() else RestoreEnemies() end
end

