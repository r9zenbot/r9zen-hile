function StartFly() local char = LocalPlayer.Character if not char then return end local hrp = char:FindFirstChild("HumanoidRootPart") if not hrp then return end if FlyBodyVelocity then FlyBodyVelocity:Destroy() end if FlyBodyGyro then FlyBodyGyro:Destroy() end FlyBodyVelocity = Instance.new("BodyVelocity") FlyBodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge) FlyBodyVelocity.Velocity = Vector3.new(0, 0, 0) FlyBodyVelocity.Parent = hrp FlyBodyGyro = Instance.new("BodyGyro") FlyBodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge) FlyBodyGyro.P = 10000 FlyBodyGyro.D = 500 FlyBodyGyro.CFrame = hrp.CFrame FlyBodyGyro.Parent = hrp end
