Toggles._v5:OnChanged(function()
    if Toggles._v5.Value and not rtxOn then
        rtxOn = true
        pcall(function()
            Lighting.Technology = Enum.Technology.Future
            Lighting.Brightness = 2.5
            Lighting.ClockTime = 14
            Lighting.EnvironmentDiffuseScale = 1
            Lighting.EnvironmentSpecularScale = 1
            local b = Instance.new("BloomEffect", Lighting)
            b.Intensity = 0.9; b.Size = 28; b.Threshold = 0.8
            table.insert(rtxItems, b)
            local c = Instance.new("ColorCorrectionEffect", Lighting)
            c.Brightness = 0.05; c.Contrast = 0.2; c.Saturation = 0.3
            table.insert(rtxItems, c)
            local s = Instance.new("SunRaysEffect", Lighting)
            s.Intensity = 0.3
            table.insert(rtxItems, s)
            local a = Instance.new("Atmosphere", Lighting)
            a.Density = 0.3; a.Color = Color3.fromRGB(190,195,215)
            a.Decay = Color3.fromRGB(100,110,125); a.Glare = 0.5; a.Haze = 1.8
            table.insert(rtxItems, a)
        end)
        Library:Notify("RTX Shader enabled!", 2)
    elseif not Toggles._v5.Value and rtxOn then
        rtxOn = false
        for _, v in pairs(rtxItems) do pcall(function() v:Destroy() end) end
        rtxItems = {}
