-- CS BHOP (gain speed per hop)
local bhopActive = false
local bhopConn
local bhopSpeed = 16
local bhopMaxSpeed = 300
local bhopGainPerHop = 5
local wasInAir = false

createSlider(movSec, "Bhop Max Speed", 50, 500, 300, function(v) bhopMaxSpeed = v end)
createSlider(movSec, "Bhop Speed Gain", 1, 30, 5, function(v) bhopGainPerHop = v end)

createToggle(movSec, "Bunny Hop (CS Style)", function(s)
    bhopActive = s
    if s then
        bhopSpeed = 16
        bhopConn = RunService.Heartbeat:Connect(function()
            local char = player.Character
            if not char then return end
            local h = char:FindFirstChild("Humanoid")
            if not h then return end
            
            local state = h:GetState()
            local onGround = (state == Enum.HumanoidStateType.Running or state == Enum.HumanoidStateType.Landed or state == Enum.HumanoidStateType.RunningNoPhysics)
            local inAir = (state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.Jumping)
            
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                if onGround then
                    -- Landing frame: gain speed and instantly jump
                    if wasInAir then
                        bhopSpeed = math.min(bhopSpeed + bhopGainPerHop, bhopMaxSpeed)
                    end
                    h:ChangeState(Enum.HumanoidStateType.Jumping)
                    h.WalkSpeed = bhopSpeed
                end
            else
                -- Not holding space: reset speed
                bhopSpeed = 16
                h.WalkSpeed = 16
            end
            
            wasInAir = inAir
        end)
    else
        if bhopConn then bhopConn:Disconnect() end
        bhopSpeed = 16
        local h = player.Character and player.Character:FindFirstChild("Humanoid")
        if h then h.WalkSpeed = 16 end
    end
end)

