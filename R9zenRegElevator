local function closeMenu()
    if animating then return end; animating=true
    TweenService:Create(MScale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.In), {Scale=0.8}):Play()
    TweenService:Create(MainFrame, TweenInfo.new(0.2), {BackgroundTransparency=1}):Play()
    task.wait(0.25); MainFrame.Visible=false; TB.Visible=true
    MScale.Scale=menuScale; menuOpen=false; animating=false
end

