                                bg.Size = UDim2.new(0, 200, 0, 50)
                                bg.StudsOffset = Vector3.new(0, 3, 0)
                                bg.AlwaysOnTop = true
                                bg.Parent = head

                                local n = Instance.new("TextLabel", bg)
                                n.Name = "N"
                                n.Size = UDim2.new(1, 0, 0.5, 0)
                                n.BackgroundTransparency = 1
                                n.Text = p.Name
                                n.TextColor3 = Color3.new(1, 0, 0)
                                n.Font = Enum.Font.GothamBold
                                n.TextSize = 14
                                n.TextStrokeTransparency = 0

                                local d = Instance.new("TextLabel", bg)
                                d.Name = "D"
                                d.Size = UDim2.new(1, 0, 0.5, 0)
                                d.Position = UDim2.new(0, 0, 0.5, 0)
                                d.BackgroundTransparency = 1
                                d.TextColor3 = Color3.new(1, 1, 1)
                                d.Font = Enum.Font.Gotham
                                d.TextSize = 11
                                d.TextStrokeTransparency = 0
                            end

                            local eg = head:FindFirstChild("R9Z_ESP")
                            if eg and root then
                                local dl = eg:FindFirstChild("D")
                                if dl then
                                    dl.Text = "[" .. math.floor((root.Position - hrp.Position).Magnitude) .. "m] HP:" .. math.floor(pH.Health)
                                end
                            end

                            if not p.Character:FindFirstChild("R9Z_HL") then
                                local hl = Instance.new("Highlight")
                                hl.Name = "R9Z_HL"
                                hl.FillColor = Color3.new(1, 0, 0)
                                hl.FillTransparency = 0.7
                                hl.OutlineColor = Color3.new(1, 0, 0)
                                hl.Parent = p.Character
                            end
                        end
                    end
                end
            end)
        else
            pcall(function()
                for _, p in pairs(Players:GetPlayers()) do
                    if p.Character then
                        local h = p.Character:FindFirstChild("Head")
                        if h then
                            local e = h:FindFirstChild("R9Z_ESP")
                            if e then e:Destroy() end
                        end
                        local hl = p.Character:FindFirstChild("R9Z_HL")
                        if hl then hl:Destroy() end
                    end
                end
            end)
        end
    end
end)

