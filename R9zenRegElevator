-- BUNNY HOP (CS 1.6 - UÇMAZ)
Toggles.BhopToggle:OnChanged(function()
    BHF.Visible = Toggles.BhopToggle.Value
    if not Toggles.BhopToggle.Value then
        bhopSpeed = 16
    end
end)

RS.RenderStepped:Connect(function()
    if not (Toggles.BhopToggle and Toggles.BhopToggle.Value) or not hum or not root then
        BHFill.Size = UDim2.new(0, 0, 1, 0)
        BHLbl.Text = "BHOP: OFF"
        return
    end

    local bhopMax = Options.BhopMaxSlider and Options.BhopMaxSlider.Value or 100
    local bhopAccel = (Options.BhopAccelSlider and Options.BhopAccelSlider.Value or 8) / 10

    local onGround = hum.FloorMaterial ~= Enum.Material.Air
    local holdSpace = UIS:IsKeyDown(Enum.KeyCode.Space)
    local strafing = UIS:IsKeyDown(Enum.KeyCode.A) or UIS:IsKeyDown(Enum.KeyCode.D)
    local moving = UIS:IsKeyDown(Enum.KeyCode.W) or UIS:IsKeyDown(Enum.KeyCode.S) or strafing

    -- Yerde + space basılı = zıpla
    if holdSpace and onGround then
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
        if strafing then
            bhopSpeed = math.min(bhopSpeed + bhopAccel, bhopMax)
        end
    end

    -- Yerde + space yok = hız sıfırla
    if onGround and not holdSpace then
        bhopSpeed = 16
    end

    -- Havada + hareket = ileri it (Y eksenine dokunma!)
    if not onGround and moving then
        local md = hum.MoveDirection
        if md.Magnitude > 0 then
            root.Velocity = Vector3.new(
                md.X * bhopSpeed,
                root.Velocity.Y,  -- Y'ye dokunmuyoruz = uçmaz
                md.Z * bhopSpeed
            )
        end
    end

    -- HUD güncelle
    local pct = math.clamp((bhopSpeed - 16) / (bhopMax - 16), 0, 1)
    BHFill.Size = UDim2.new(pct, 0, 1, 0)
    BHLbl.Text = "BHOP: " .. math.floor(bhopSpeed)

    if pct < 0.3 then BHFill.BackgroundColor3 = Color3.fromRGB(0, 200, 255)
    elseif pct < 0.6 then BHFill.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
    else BHFill.BackgroundColor3 = Color3.fromRGB(255, 50, 50) end
end)

