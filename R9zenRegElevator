local coinTab = createTab("Auto Coin")
local coinSec = createSection(coinTab, "Collect")

local coinActive = false
local coinCount = 0
local coinStatus = createLabel(coinSec, "Status: Off", C.TextDim)
local coinCounter = createLabel(coinSec, "Collected: 0", C.TextDim)

createToggle(coinSec, "Auto Collect", function(s)
    coinActive = s
    if s then
        coinStatus.Text = "Status: Running"; coinStatus.TextColor3 = C.Green
        task.spawn(function()
            while coinActive do
                local char = player.Character
                if not char then task.wait(1) continue end
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if not hrp then task.wait(1) continue end
                
                local oldCF = hrp.CFrame
                local collected = false
                
                for _, v in pairs(workspace:GetDescendants()) do
                    if not coinActive then break end
                    if not v or not v.Parent then continue end
                    
                    local isCoin = false
                    
                    if v:IsA("BasePart") and v:FindFirstChild("TouchInterest") then
                        local n = v.Name:lower()
                        if not n:find("spawn") and not n:find("floor") and not n:find("wall") and not n:find("base") then
                            isCoin = true
                        end
                    end
                    
                    if v:IsA("BasePart") or v:IsA("MeshPart") or v:IsA("UnionOperation") then
                        local n = v.Name:lower()
                        if n:find("coin") or n:find("cash") or n:find("money")
                            or n:find("gem") or n:find("collect") or n:find("pickup")
                            or n:find("token") or n:find("orb") or n:find("currency") then
                            isCoin = true
                        end
                    end
                    
                    if v.Parent and (v:IsA("BasePart") or v:IsA("MeshPart")) then
                        local pn = v.Parent.Name:lower()
                        if pn:find("coin") or pn:find("cash") or pn:find("money")
                            or pn:find("collect") or pn:find("pickup") or pn:find("token") then
                            isCoin = true
                        end
                    end
                    
                    if isCoin and v.Parent then
                        hrp.CFrame = v.CFrame
                        pcall(function()
                            if firetouchinterest then
                                firetouchinterest(hrp, v, 0)
                                task.wait()
                                firetouchinterest(hrp, v, 1)
                            end
                        end)
                        pcall(function()
                            if getconnections then
                                for _, conn in pairs(getconnections(v.Touched)) do
                                    pcall(function() conn:Fire(hrp) end)
                                end
                            end
                        end)
                        coinCount = coinCount + 1
                        coinCounter.Text = "Collected: " .. coinCount
                        collected = true
                        task.wait(0.1)
                    end
                end
                
                pcall(function()
                    if hrp and hrp.Parent then hrp.CFrame = oldCF end
                end)
                
                task.wait(collected and 1 or 3)
            end
            coinStatus.Text = "Status: Off"; coinStatus.TextColor3 = C.TextDim
        end)
    end
end)

createButton(coinSec, "Reset Counter", C.Toggle, function()
    coinCount = 0; coinCounter.Text = "Collected: 0"
end)

