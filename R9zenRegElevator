local function clearESP()
    for _, o in pairs(espObjects) do pcall(function() o:Destroy() end) end
    espObjects = {}
    for _, c in pairs(espConns) do c:Disconnect() end
    espConns = {}
end

local function createESP(target)
    if target == player then return end
    local char = target.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    local head = char:FindFirstChild("Head")
    if not hrp or not hum or not head then return end

    local hl = Instance.new("Highlight")
    hl.FillColor = Color3.fromRGB(espR,espG,espB)
    hl.OutlineColor = Color3.fromRGB(espR,espG,espB)
    hl.FillTransparency = 0.5; hl.Adornee = char
    hl.Parent = espFolder; table.insert(espObjects, hl)

    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0,200,0,60); bb.StudsOffset = Vector3.new(0,3,0)
    bb.AlwaysOnTop = true; bb.Adornee = head
    bb.Parent = espFolder; table.insert(espObjects, bb)

    local nl = Instance.new("TextLabel", bb)
    nl.Size=UDim2.new(1,0,0,18); nl.BackgroundTransparency=1
    nl.Text=target.Name; nl.TextColor3=Color3.fromRGB(espR,espG,espB)
    nl.TextSize=14; nl.Font=Enum.Font.GothamBold; nl.TextStrokeTransparency=0

    local hpBg = Instance.new("Frame", bb)
    hpBg.Size=UDim2.new(0.7,0,0,6); hpBg.Position=UDim2.new(0.15,0,0,20)
    hpBg.BackgroundColor3=Color3.fromRGB(40,40,40); hpBg.BorderSizePixel=0
    Instance.new("UICorner", hpBg).CornerRadius=UDim.new(1,0)
    local hpF = Instance.new("Frame", hpBg)
    hpF.Size=UDim2.new(1,0,1,0); hpF.BackgroundColor3=Color3.fromRGB(0,255,0); hpF.BorderSizePixel=0
    Instance.new("UICorner", hpF).CornerRadius=UDim.new(1,0)

    local dl = Instance.new("TextLabel", bb)
    dl.Size=UDim2.new(1,0,0,14); dl.Position=UDim2.new(0,0,0,28)
    dl.BackgroundTransparency=1; dl.Text="0m"; dl.TextColor3=Color3.fromRGB(200,200,200)
    dl.TextSize=11; dl.Font=Enum.Font.Gotham; dl.TextStrokeTransparency=0

    local line = Instance.new("Part")
    line.Anchored=true; line.CanCollide=false; line.Material=Enum.Material.Neon
    line.Color=Color3.fromRGB(espR,espG,espB); line.Transparency=0.3
    line.Parent=espFolder; table.insert(espObjects, line)

    local conn = RunService.RenderStepped:Connect(function()
        if not char or not char.Parent or not hrp or not hrp.Parent then return end
        local myHRP = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if not myHRP then return end
        local col = Color3.fromRGB(espR,espG,espB)
        hl.FillColor=col; hl.OutlineColor=col
        nl.Visible=espShowNames; nl.TextColor3=col
        hpBg.Visible=espShowHP
        if hum.Health and hum.MaxHealth then
            local r=math.clamp(hum.Health/hum.MaxHealth,0,1)
            hpF.Size=UDim2.new(r,0,1,0)
            hpF.BackgroundColor3=Color3.fromRGB(255*(1-r),255*r,0)
        end
        dl.Visible=espShowDist
        dl.Text=math.floor((myHRP.Position-hrp.Position).Magnitude).."m"
        line.Visible=espShowLines
        if espShowLines then
            local mid=(myHRP.Position+hrp.Position)/2
            local d=(myHRP.Position-hrp.Position).Magnitude
            line.Size=Vector3.new(0.1,0.1,d)
            line.CFrame=CFrame.lookAt(mid,hrp.Position); line.Color=col
        end
    end)
    table.insert(espConns, conn)
end

createToggle(espSec, "Enable ESP", function(s)
    espEnabled = s
    if s then
