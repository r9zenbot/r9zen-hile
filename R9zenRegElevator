-- Bunny Hop
Toggles._b1:OnChanged(function()
    BF.Visible = Toggles._b1.Value
    if not Toggles._b1.Value then bhopSpeed = 16 end
end)

RS.RenderStepped:Connect(function()
    if not (Toggles._b1 and Toggles._b1.Value) or not hum or not root then
        BFF.Size = UDim2.new(0,0,1,0)
        BFL.Text = "BHOP: OFF"
        return
    end
    local bMax = Options._b2 and Options._b2.Value or 100
    local bAcc = (Options._b3 and Options._b3.Value or 8) / 10
    local onG = hum.FloorMaterial ~= Enum.Material.Air
    local spc = UIS:IsKeyDown(Enum.KeyCode.Space)
    local str = UIS:IsKeyDown(Enum.KeyCode.A) or UIS:IsKeyDown(Enum.KeyCode.D)
    local mov = UIS:IsKeyDown(Enum.KeyCode.W) or UIS:IsKeyDown(Enum.KeyCode.S) or str

    if spc and onG then
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
        if str then bhopSpeed = math.min(bhopSpeed + bAcc, bMax) end
    end
    if onG and not spc then bhopSpeed = 16 end
    if not onG and mov then
        local md = hum.MoveDirection
        if md.Magnitude > 0 then
            root.Velocity = Vector3.new(md.X * bhopSpeed, root.Velocity.Y, md.Z * bhopSpeed)
        end
    end

    local pct = math.clamp((bhopSpeed - 16) / (bMax - 16), 0, 1)
    BFF.Size = UDim2.new(pct, 0, 1, 0)
    BFL.Text = "BHOP: " .. math.floor(bhopSpeed)
    if pct < 0.3 then BFF.BackgroundColor3 = Color3.fromRGB(0,200,255)
    elseif pct < 0.6 then BFF.BackgroundColor3 = Color3.fromRGB(255,200,0)
    else BFF.BackgroundColor3 = Color3.fromRGB(255,50,50) end
end)

