RS.RenderStepped:Connect(function()
    fC = fC + 1
    if tick() - lT >= 1 then
        local fps = math.floor(fC / (tick() - lT))
        FT.Text = "FPS: " .. fps
        if fps >= 60 then FT.TextColor3 = Color3.fromRGB(0,255,100)
        elseif fps >= 30 then FT.TextColor3 = Color3.fromRGB(255,200,0)
        else FT.TextColor3 = Color3.fromRGB(255,60,60) end
        fC = 0
        lT = tick()
    end
    if root then
        ST.Text = "⚡ " .. math.floor(Vector3.new(root.Velocity.X,0,root.Velocity.Z).Magnitude) .. " s/s"
    end
end)

