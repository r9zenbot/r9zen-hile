-- FPS Hesap
local fCount, lTime = 0, tick()
RS.RenderStepped:Connect(function()
    fCount = fCount + 1
    if tick() - lTime >= 1 then
        local fps = math.floor(fCount / (tick() - lTime))
        FPST.Text = "FPS: " .. fps
        if fps >= 60 then FPST.TextColor3 = Color3.fromRGB(0, 255, 100)
        elseif fps >= 30 then FPST.TextColor3 = Color3.fromRGB(255, 200, 0)
        else FPST.TextColor3 = Color3.fromRGB(255, 60, 60) end
        fCount = 0
        lTime = tick()
    end
    if root then
        SPT.Text = "⚡ " .. math.floor(Vector3.new(root.Velocity.X, 0, root.Velocity.Z).Magnitude) .. " s/s"
    end
end)

