    local bar = Instance.new("Frame", btn)
    bar.Size = UDim2.new(0,3,0.5,0); bar.Position = UDim2.new(0,-7,0.25,0)
    bar.BackgroundColor3 = C.Accent; bar.Visible = false
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1,0)
