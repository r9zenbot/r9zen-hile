    MainFrame.Visible=true; TB.Visible=false
    MScale.Scale=0.8; MainFrame.BackgroundTransparency=1
    TweenService:Create(MScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale=menuScale}):Play()
