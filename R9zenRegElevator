    page.Size = UDim2.new(1,-16,1,-16); page.Position = UDim2.new(0,8,0,8)
    page.BackgroundTransparency = 1; page.ScrollBarThickness = 3
    page.ScrollBarImageColor3 = C.Accent; page.AutomaticCanvasSize = Enum.AutomaticSize.Y
